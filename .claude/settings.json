{
  "permissions": {
    "allow": [
      "Bash(./build.sh *)",
      "Bash(./tools/check.sh *)",
      "Bash(./tools/cargo.sh *)",
      "Bash(npx tsc)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(npm run build)",
      "mcp__Claude_Browser__read_console_messages"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-rust.sh\"",
            "statusMessage": "rustfmt (repository toolchain)"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-loop.sh\" post-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-force-push-main.sh\"",
            "statusMessage": "guard force-push to main"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-loop.sh\" pre-hook"
          }
        ]
      }
    ]
  }
}
