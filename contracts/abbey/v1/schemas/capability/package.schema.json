{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v1/schemas/capability/package.schema.json",
  "title": "Capability package",
  "x-abbey-data-class": "authorization-metadata",
  "x-abbey-max-bytes": 32768,
  "x-abbey-unknown-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "capability_version",
    "package_digest",
    "input_schema_id",
    "output_schema_id",
    "error_schema_id",
    "risk_class",
    "side_effect",
    "reversibility",
    "data_classes",
    "residency",
    "retention",
    "cancellation",
    "deadline_required",
    "idempotency_required",
    "receipt_required"
  ],
  "properties": {
    "capability_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "capability_version": {"type": "string", "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+", "maxLength": 32},
    "package_digest": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "input_schema_id": {"type": "string", "pattern": "https://abbey.local/contracts/abbey/v1/schemas/[a-z0-9_./-]+", "maxLength": 256},
    "output_schema_id": {"type": "string", "pattern": "https://abbey.local/contracts/abbey/v1/schemas/[a-z0-9_./-]+", "maxLength": 256},
    "error_schema_id": {"type": "string", "pattern": "https://abbey.local/contracts/abbey/v1/schemas/[a-z0-9_./-]+", "maxLength": 256},
    "risk_class": {"enum": ["Informational", "Low", "Medium", "High", "Prohibited"]},
    "side_effect": {"enum": ["none", "ephemeral", "durable", "platform"]},
    "reversibility": {"enum": ["not_applicable", "reversible", "compensatable", "irreversible"]},
    "data_classes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["public", "metadata", "pseudonymous", "private", "restricted"]}},
    "residency": {"enum": ["deployment_local", "tenant_region", "declared_external"]},
    "retention": {"enum": ["none", "ephemeral", "policy_bound"]},
    "cancellation": {"enum": ["required", "not_applicable"]},
    "deadline_required": {"type": "boolean"},
    "idempotency_required": {"type": "boolean"},
    "receipt_required": {"type": "boolean"},
    "platform_permissions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9_.-]{0,63}"}},
    "resource_requirements": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9_.-]{0,63}"}}
  }
}
