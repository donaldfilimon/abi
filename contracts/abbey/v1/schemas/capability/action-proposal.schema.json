{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v1/schemas/capability/action-proposal.schema.json",
  "title": "Typed expiring action proposal",
  "x-abbey-data-class": "authorization-metadata",
  "x-abbey-max-bytes": 32768,
  "x-abbey-unknown-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "proposal_digest", "capability_id", "capability_version", "scope_digest", "risk_class", "uncertainty", "precondition_codes", "expected_effect_digest", "approval_required", "expires_at", "verification_codes", "rollback_code", "steps"],
  "properties": {
    "proposal_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "proposal_digest": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "capability_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "capability_version": {"type": "string", "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+", "maxLength": 32},
    "scope_digest": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "risk_class": {"enum": ["Informational", "Low", "Medium", "High", "Prohibited"]},
    "uncertainty": {"enum": ["none", "bounded", "material", "unknown"]},
    "precondition_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9_-]{0,63}"}},
    "expected_effect_digest": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "approval_required": {"type": "boolean"},
    "expires_at": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/utc_instant"},
    "verification_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9_-]{0,63}"}},
    "rollback_code": {"type": "string", "pattern": "[a-z][a-z0-9_-]{0,63}"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["step_id", "operation_code"], "properties": {"step_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"}, "operation_code": {"type": "string", "pattern": "[a-z][a-z0-9_-]{0,63}"}}}}
  }
}
