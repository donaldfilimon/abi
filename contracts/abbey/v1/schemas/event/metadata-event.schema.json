{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v1/schemas/event/metadata-event.schema.json",
  "title": "Ordered metadata-only event",
  "x-abbey-data-class": "redacted-metadata",
  "x-abbey-max-bytes": 8192,
  "x-abbey-unknown-fields": "extensions-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["correlation_id", "sequence", "event_kind", "occurred_at"],
  "properties": {
    "correlation_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "sequence": {"type": "string", "pattern": "(?:0|[1-9][0-9]{0,18})"},
    "event_kind": {"enum": ["accepted", "provider_started", "provider_stopped", "actuator_started", "actuator_stopped", "verification_started", "verification_stopped"]},
    "occurred_at": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/utc_instant"},
    "extensions": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "maxLength": 128},
          {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
          {"type": "boolean"},
          {"type": "null"}
        ]
      }
    }
  }
}
