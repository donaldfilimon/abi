{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v1/schemas/receipt/outcome-receipt.schema.json",
  "title": "Redacted fixed outcome receipt",
  "x-abbey-data-class": "redacted-metadata",
  "x-abbey-max-bytes": 16384,
  "x-abbey-unknown-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "correlation_id", "decision", "reason_code", "capability_version", "contract_digest", "build_id", "policy_versions_digest", "authorization_result", "approval_result", "step_counts", "postcondition_result", "compensation_result", "rollback_state", "cancellation_state", "deadline_state", "rate_state", "budget_state", "evidence_references", "redacted", "truncated"],
  "properties": {
    "receipt_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "correlation_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "decision": {"enum": ["allowed", "denied", "cancelled", "error", "outcome_unresolved"]},
    "reason_code": {"enum": ["success", "authorization", "approval", "cancellation", "deadline", "dependency", "verification", "compensation", "outcome_unresolved"]},
    "capability_version": {"type": "string", "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+", "maxLength": 32},
    "contract_digest": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "build_id": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "policy_versions_digest": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "authorization_result": {"enum": ["allowed", "denied", "not_evaluated"]},
    "approval_result": {"enum": ["valid", "missing", "invalid", "not_required"]},
    "step_counts": {"type": "object", "additionalProperties": false, "required": ["not_started", "completed", "reverted", "unresolved"], "properties": {"not_started": {"type": "integer", "minimum": 0, "maximum": 10000}, "completed": {"type": "integer", "minimum": 0, "maximum": 10000}, "reverted": {"type": "integer", "minimum": 0, "maximum": 10000}, "unresolved": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "postcondition_result": {"enum": ["satisfied", "failed", "not_checked", "unknown"]},
    "compensation_result": {"enum": ["not_needed", "complete", "partial", "failed", "unknown"]},
    "rollback_state": {"enum": ["not_needed", "completed", "partial", "failed", "unknown"]},
    "cancellation_state": {"enum": ["not_requested", "requested", "observed", "raced"]},
    "deadline_state": {"enum": ["within", "expired", "unknown"]},
    "rate_state": {"enum": ["within", "exceeded", "unknown"]},
    "budget_state": {"enum": ["within", "exhausted", "unknown"]},
    "evidence_references": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json#/$defs/opaque_id"}},
    "redacted": {"const": true},
    "truncated": {"type": "boolean"}
  }
}
