{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v1/schemas/common/definitions.schema.json",
  "title": "Abbey common bounded definitions",
  "x-abbey-data-class": "metadata",
  "x-abbey-max-bytes": 4096,
  "x-abbey-unknown-fields": "reject",
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "[a-z][a-z0-9_-]{0,63}"
    },
    "digest_id": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "utc_instant": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "duration_ms": {
      "type": "string",
      "pattern": "(?:0|[1-9][0-9]{0,7})"
    }
  }
}
