{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v2/schemas/capability/package.schema.json",
  "title": "Compiled capability package v2",
  "x-abbey-data-class": "authorization",
  "x-abbey-max-bytes": 65536,
  "x-abbey-unknown-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "capability_version", "package_digest", "input_schema_digest", "output_schema_digest", "error_schema_digest", "side_effect", "reversibility", "risk_class", "retention_class", "required_platform_permissions", "approval_floor", "idempotency", "deadline_ms", "rate_class", "budget_class", "postconditions", "adapter_bindings", "receipt_profile", "promotion_evidence_level", "state"],
  "properties": {
    "capability_id": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/capability_id"},
    "capability_version": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/semver"},
    "package_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "input_schema_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "output_schema_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "error_schema_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "side_effect": {"enum": ["None", "LocalState", "PlatformRead", "PlatformWrite"]},
    "reversibility": {"enum": ["Reversible", "ReversibleWithLoss", "Irreversible"]},
    "risk_class": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/risk_class"},
    "retention_class": {"enum": ["Ephemeral", "Session", "Operational", "Durable", "MandatoryIncident"]},
    "required_platform_permissions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/opaque_id"}},
    "approval_floor": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/approval_level"},
    "idempotency": {"enum": ["RequiresKey", "NaturallyIdempotent", "NotIdempotent"]},
    "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "rate_class": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "budget_class": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "postconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/opaque_id"}},
    "adapter_bindings": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["recording-v1"]}},
    "receipt_profile": {"const": "redacted-v2"},
    "promotion_evidence_level": {"enum": ["C0", "C1", "C2"]},
    "state": {"enum": ["candidate", "current", "revoked"]}
  }
}
