{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v2/schemas/capability/change-set.schema.json",
  "title": "Immutable digest-bound ChangeSet",
  "x-abbey-data-class": "authorization",
  "x-abbey-max-bytes": 65536,
  "x-abbey-unknown-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "change_set_digest", "requested_by", "proposed_by", "guild_ref", "capability_id", "capability_version", "package_digest", "compensation_class", "risk_class", "required_approval", "precondition_digest", "expected_postcondition_digest", "rollback_digest", "snapshot_digest", "generator_digest", "created_at_ms", "expires_at_ms", "prepared_ttl_ms"],
  "properties": {
    "operation_id": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "change_set_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "requested_by": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/principal_ref"},
    "proposed_by": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/principal_ref"},
    "guild_ref": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/opaque_id"},
    "capability_id": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/capability_id"},
    "capability_version": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/semver"},
    "package_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "compensation_class": {"enum": ["ExactRestore", "BestEffort", "None"]},
    "risk_class": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/risk_class"},
    "required_approval": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/approval_level"},
    "precondition_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "expected_postcondition_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "rollback_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "snapshot_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "generator_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "created_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "prepared_ttl_ms": {"type": "integer", "minimum": 1, "maximum": 120000}
  }
}
