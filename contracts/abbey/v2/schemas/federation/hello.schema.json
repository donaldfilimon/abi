{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbey.local/contracts/abbey/v2/schemas/federation/hello.schema.json",
  "title": "Abbey v1 federation hello",
  "x-abbey-data-class": "metadata",
  "x-abbey-max-bytes": 8192,
  "x-abbey-unknown-fields": "reject",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "supported_contract_majors", "contract_revision", "corpus_digest", "capability_manifest_digest", "deployment_profile"],
  "properties": {
    "service": {"const": "abbey.v1"},
    "supported_contract_majors": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 2}},
    "contract_revision": {"const": 2},
    "corpus_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "capability_manifest_digest": {"$ref": "https://abbey.local/contracts/abbey/v2/schemas/common/definitions.schema.json#/$defs/digest_id"},
    "deployment_profile": {"enum": ["developer", "federated_c6"]}
  }
}
