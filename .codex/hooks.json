{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && bash \"$root/.claude/hooks/block-force-push-main.sh\"",
            "statusMessage": "guard force-push to main"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && bash \"$root/.claude/hooks/skill-loop.sh\" pre-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && bash \"$root/.claude/hooks/format-rust.sh\"",
            "statusMessage": "rustfmt (repository toolchain)"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && bash \"$root/.claude/hooks/skill-loop.sh\" post-hook"
          }
        ]
      }
    ]
  }
}
